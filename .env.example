# ============================================================
# T7 Learning Hub — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.
#
# SECURITY:
#   VITE_ prefix  = bundled into browser JS (public)
#   No VITE_ prefix = server-only, used only by /api/ functions
# ============================================================


# --- DeepTutor / Academic Mode ---
VITE_DEEPTUTOR_URL=http://localhost:3782

# ============================================================
# SERVER-ONLY KEYS (used by Vercel Serverless /api/ functions)
# Add these WITHOUT VITE_ prefix in Vercel → Settings → Env Vars
# ============================================================

# --- LYZR AI AGENTS (https://agent.lyzr.ai) ---
# Your primary Lyzr API Key (obtained from Lyzr Studio account settings)
LYZR_API_KEY=your_lyzr_api_key_here

# Lyzr Agent IDs:
# 1. Profile Analyzer Agent (Campus Placement Readiness & Skill Gap Analyzer)
LYZR_AGENT_PROFILE=your_profile_analyzer_agent_id

# 2. Resume Optimizer Agent (ATS Resume & Impact Auditor)
LYZR_AGENT_RESUME=your_resume_optimizer_agent_id

# 3. Tutor Bot Agent (T7 SKILL_BOT AI Mentor)
LYZR_AGENT_TUTOR=your_tutor_agent_id

# 4. Skill Validator Agent (Quiz & Knowledge Engine)
LYZR_AGENT_VALIDATOR=your_skill_validator_agent_id

# JSearch (RapidAPI) — https://rapidapi.com/letscrape-6bRBa3qguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here

# Adzuna — https://developer.adzuna.com/
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# Jooble (Optional) — https://jooble.org/api/about
JOOBLE_API_KEY=your_jooble_api_key_here

# --- Supabase Enterprise PostgreSQL (Server-Only — Zero Client Secrets) ---
# Find in: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here

