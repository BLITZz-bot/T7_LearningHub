# ============================================================
# T7 Learning Hub — Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit your .env file to version control.
# ============================================================

# --- Firebase Configuration ---
# Get these from: Firebase Console → Project Settings → Your Apps → Config
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id

# --- Gemini AI API Key ---
# Get this from: https://aistudio.google.com/apikey
# WARNING: This key is bundled into the frontend build.
# Consider moving AI calls to a backend/Cloud Function for production.
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# --- DeepTutor / Academic Mode ---
# URL where T7Tutor (DeepTutor) is running locally.
# Default: http://localhost:3782
VITE_DEEPTUTOR_URL=http://localhost:3782

# --- Real-Time Job Market APIs (Optional) ---
# 1. JSearch API (RapidAPI — Google for Jobs / LinkedIn / Indeed / Glassdoor)
# Get from: https://rapidapi.com/letscrape-6bRBa3qguO5/api/jsearch
VITE_RAPIDAPI_KEY=your_rapidapi_key_here

# 2. Adzuna API (Official Licensed Global Aggregator)
# Register at: https://developer.adzuna.com/
VITE_ADZUNA_APP_ID=your_adzuna_app_id_here
VITE_ADZUNA_APP_KEY=your_adzuna_app_key_here
